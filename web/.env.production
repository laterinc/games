# 生产构建（npm run build，Vite mode=production）
#
# 默认留空 = 同源单端口部署：页面、/api、/ws 全部在后端同一域名端口（8765），
# 由 backend 托管 web/dist，这是本项目推荐的部署方式，无需任何配置。
#
# 若真实生产地址不便提交到仓库，请复制本文件为 .env.production.local
# （已在 .gitignore 中）再填写；也可以在构建命令前注入：
#   VITE_API_BASE=https://api.example.com VITE_WS_URL=wss://api.example.com/ws npm run build
# Docker 构建可传 --build-arg（见 Dockerfile / docker-compose.yml）。

VITE_WS_URL=https://cloudflare.org.cn/gomoku/ws
VITE_API_BASE=https://cloudflare.org.cn/gomoku/api

# —— 前后端分域部署示例（取消注释并替换成你的真实域名）——
# VITE_API_BASE=https://gomoku-api.example.com
# VITE_WS_URL=wss://gomoku-api.example.com/ws

# 注意：Vite 变量是「构建期静态注入」，改完必须重新 npm run build；
# 只改服务器环境变量不会影响已构建的 dist。
