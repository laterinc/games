# 开发模式（npm run dev，Vite mode=development）
#
# 默认留空 = 同源 http://localhost:5173：
#   /api、/ws 都由 vite.config.ts 的 proxy 转发到 http://127.0.0.1:8765。
# 只有「开发前端直接连另一台/另一个端口的后端、不走代理」时才需要改这里。

VITE_BASE_PATH=/
VITE_WS_URL=
VITE_API_BASE=
# 后端端口不是 8765 时，让 Vite 代理指向正确地址（仅 dev/preview 使用）
# DEV_BACKEND=http://127.0.0.1:8281

# 例：直连本机 8765（绕过代理）
# VITE_API_BASE=http://127.0.0.1:8765
# VITE_WS_URL=ws://127.0.0.1:8765/ws

# 例：连局域网/测试环境后端（记得后端设置 CORS_ORIGINS / ALLOWED_ORIGINS）
# VITE_API_BASE=http://192.168.1.10:8765
# VITE_WS_URL=ws://192.168.1.10:8765/ws
