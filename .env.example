# ---- 后端应用配置（只提供 API/WS；前端由 Nginx/CDN 托管）----
# 监听地址/端口不在 .env：用启动参数，例如 python run.py --host 127.0.0.1 --port 8000
BOARD_SIZE=15
# REST 跨域来源（同域部署可留默认；前端独立域名时填前端域名）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# WS 握手的 Origin 白名单，逗号分隔；留空表示不校验。公网部署建议填你的域名
ALLOWED_ORIGINS=
ROOM_TTL_SECONDS=21600
DISCONNECT_GRACE_SECONDS=60
