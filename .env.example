# ---- 服务端 ----
HOST=0.0.0.0
PORT=8765
# 前端静态产物目录；留空则使用 web/dist（仅 SERVE_STATIC=1 时生效）
WEB_DIST=
# 1 = 后端同端口托管前端（单端口部署，默认）
# 0 = 纯 API/WS，前端交给 Nginx/CDN（后端独立部署用这个）
SERVE_STATIC=1
BOARD_SIZE=15
# REST 跨域来源（同源部署可留默认）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# WS 握手的 Origin 白名单，逗号分隔；留空表示不校验。公网部署建议填你的域名
ALLOWED_ORIGINS=
ROOM_TTL_SECONDS=21600
DISCONNECT_GRACE_SECONDS=60
