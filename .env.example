# ---- 服务端 ----
HOST=0.0.0.0
PORT=8765
# 前端静态产物目录；留空则使用 web/dist
WEB_DIST=
# 是否由后端托管前端页面（1=单端口部署；0=纯 API/WS，前端交给 Nginx/CDN）
SERVE_STATIC=1
BOARD_SIZE=15
# REST 跨域来源（同源部署可留默认）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# WS 握手的 Origin 白名单，逗号分隔；留空表示不校验。公网部署建议填你的域名
ALLOWED_ORIGINS=
ROOM_TTL_SECONDS=21600
DISCONNECT_GRACE_SECONDS=60
