# 五子棋后端环境变量清单
#
# 后端只提供 /api 与 /ws，不托管前端静态文件；前端由 Nginx/CDN 托管。
#
# 加载方式：
# - scripts/start.sh / dev.sh 会自动加载：先仓库根 .env，再本文件（本文件优先）
# - 直接 uvicorn 启动：--host/--port 必须显式传，再加 --env-file .env 注入应用变量
# - 服务端代码本身不自动读取 .env

# 监听地址/端口不在这里配置，用启动参数：
#   python run.py --host 127.0.0.1 --port 8000
#   ./scripts/start.sh --host 127.0.0.1 --port 8000

# 棋盘尺寸（≥5，默认 15）
BOARD_SIZE=15

# HTTP CORS 白名单（逗号分隔；同域部署无需配置；前端独立域名时填前端域名）
CORS_ORIGINS=

# WebSocket 握手 Origin 白名单（逗号分隔；留空 = 放行任意 Origin；建议填前端域名）
ALLOWED_ORIGINS=

# waiting 房间空闲回收时长（秒，默认 6 小时）
ROOM_TTL_SECONDS=21600

# 断线宽限时长（秒，默认 60）
DISCONNECT_GRACE_SECONDS=60
