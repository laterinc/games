# 五子棋服务端环境变量清单
# - scripts/start.sh / dev.sh 会自动加载：先仓库根 .env，再本文件（本文件优先）
# - 直接 uvicorn 启动：加 --env-file .env，或先 `set -a; . ./.env; set +a`
# - 服务端代码本身不自动读取 .env
# 全部变量均有协议默认值，不设置即可本地运行。

# 监听地址与端口
HOST=0.0.0.0
PORT=8765

# 棋盘尺寸（≥5，默认 15）
BOARD_SIZE=15

# HTTP CORS 白名单（逗号分隔；生产同源无需 CORS）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# WebSocket 握手 Origin 白名单（逗号分隔；留空 = 放行任意 Origin）
ALLOWED_ORIGINS=

# waiting 房间空闲回收时长（秒，默认 6 小时）
ROOM_TTL_SECONDS=21600

# 断线宽限时长（秒，默认 60）
DISCONNECT_GRACE_SECONDS=60

# 前端构建产物目录（默认 web/dist；相对路径基于仓库根目录）
WEB_DIST=web/dist
# 是否由后端托管前端（1=单端口；0=只提供 /api 与 /ws，前端交给 Nginx/CDN）
SERVE_STATIC=1
