# 五子棋服务端环境变量清单（scripts/start.sh 读取 gomoku/.env；
# 直接 uvicorn 启动时请先 export 这些变量，服务端不自动加载本文件）
# 全部变量均有协议默认值，不设置即可本地运行。

# 监听地址与端口
HOST=0.0.0.0
PORT=8765

# 棋盘尺寸（≥5，默认 15）
BOARD_SIZE=15

# HTTP CORS 白名单（逗号分隔；生产同源无需 CORS）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# WebSocket 握手 Origin 白名单（逗号分隔；留空 = 放行任意 Origin）
ALLOWED_ORIGINS=

# waiting 房间空闲回收时长（秒，默认 6 小时）
ROOM_TTL_SECONDS=21600

# 断线宽限时长（秒，默认 60）
DISCONNECT_GRACE_SECONDS=60

# 前端构建产物目录（默认 gomoku/web/dist；相对路径基于 gomoku/）
WEB_DIST=web/dist
