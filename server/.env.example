# 五子棋后端环境变量清单（后端独立部署 / 宝塔等）
#
# 适用场景：Nginx / CDN 托管前端，本进程只提供 /api 与 /ws。
# 若要让后端同端口托管前端（单端口部署），请看仓库根目录的 .env.example，
# 或把下方 SERVE_STATIC 改为 1 并设置 WEB_DIST。
#
# 加载方式：
# - scripts/start.sh / dev.sh 会自动加载：先仓库根 .env，再本文件（本文件优先）
# - 直接 uvicorn 启动：加 --env-file .env，或先 `set -a; . ./.env; set +a`
# - 服务端代码本身不自动读取 .env

# 监听地址与端口
# 前面有 Nginx 反代时用 127.0.0.1 即可；直接对外才用 0.0.0.0 并放行端口
HOST=127.0.0.1
PORT=8000

# 棋盘尺寸（≥5，默认 15）
BOARD_SIZE=15

# HTTP CORS 白名单（逗号分隔；同域部署无需配置；前端独立域名时填前端域名）
CORS_ORIGINS=

# WebSocket 握手 Origin 白名单（逗号分隔；留空 = 放行任意 Origin；建议填前端域名）
ALLOWED_ORIGINS=

# waiting 房间空闲回收时长（秒，默认 6 小时）
ROOM_TTL_SECONDS=21600

# 断线宽限时长（秒，默认 60）
DISCONNECT_GRACE_SECONDS=60

# ---- 前端静态托管（可选）----
# 0 = 后端纯 API/WS，前端由 Nginx/CDN 托管（推荐本文件的使用场景）
# 1 = 后端同时托管前端构建产物（单端口部署）
SERVE_STATIC=0

# 仅 SERVE_STATIC=1 时生效：前端 dist 目录，建议写绝对路径
# WEB_DIST=/www/wwwroot/gomoku/web/dist
